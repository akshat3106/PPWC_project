# Port the backend listens on
PORT=5000

# Resend (https://resend.com) API key — create one at
# https://resend.com/api-keys after signing up.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address. Must be on a domain you've verified in Resend
# (https://resend.com/domains) — until then, sending is restricted to
# your own account email.
MAIL_FROM_ADDRESS=attendance@yourdomain.com
MAIL_FROM_NAME=Attendly

# Comma-separated list of origins allowed to call this API.
# The Vite dev server runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173
